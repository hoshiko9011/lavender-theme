{
  "name": "Lavender Light",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#F8F5FF",
    "editor.foreground": "#2D2A3E",
    "editor.selectionBackground": "#E8DEFF",
    "editor.selectionHighlightBackground": "#E8DEFF55",
    "editorLineNumber.foreground": "#C9BEE8",
    "editorLineNumber.activeForeground": "#4A3F6B",
    "editorCursor.foreground": "#C792EA",
    "editorIndentGuide.background": "#E8DEFF44",
    "editorIndentGuide.activeBackground": "#C9BEE8",
    "editorBracketMatch.background": "#E8DEFF66",
    "editorBracketMatch.border": "#C792EA",
    "editor.findMatchBackground": "#E8DEFF88",
    "editor.findMatchHighlightBackground": "#E8DEFF44",
    "editorRuler.foreground": "#E8DEFF44",
    "activityBar.background": "#F0EBFF",
    "activityBar.foreground": "#4A3F6B",
    "activityBar.inactiveForeground": "#C9BEE8",
    "activityBarBadge.background": "#C792EA",
    "activityBarBadge.foreground": "#FFFFFF",
    "sideBar.background": "#F5F0FF",
    "sideBar.foreground": "#2D2A3E",
    "sideBarTitle.foreground": "#4A3F6B",
    "sideBarSectionHeader.background": "#F0EBFF",
    "sideBarSectionHeader.foreground": "#4A3F6B",
    "statusBar.background": "#EDE6FF",
    "statusBar.foreground": "#4A3F6B",
    "statusBar.noFolderBackground": "#EDE6FF",
    "statusBar.debuggingBackground": "#EDE6FF",
    "tab.activeBackground": "#FFFFFF",
    "tab.activeForeground": "#4A3F6B",
    "tab.inactiveBackground": "#F5F0FF",
    "tab.inactiveForeground": "#C9BEE8",
    "tab.border": "#F0EBFF",
    "tab.unfocusedActiveBackground": "#FFFFFF",
    "tab.unfocusedInactiveBackground": "#F5F0FF",
    "panel.background": "#F5F0FF",
    "panel.border": "#F0EBFF",
    "panelTitle.activeForeground": "#4A3F6B",
    "panelTitle.inactiveForeground": "#C9BEE8",
    "titleBar.activeBackground": "#EDE6FF",
    "titleBar.activeForeground": "#2D2A3E",
    "titleBar.inactiveBackground": "#EDE6FF",
    "titleBar.inactiveForeground": "#C9BEE8",
    "scrollbarSlider.background": "#C9BEE866",
    "scrollbarSlider.hoverBackground": "#C792EA88",
    "scrollbarSlider.activeBackground": "#C792EA",
    "input.background": "#FFFFFF",
    "input.foreground": "#2D2A3E",
    "input.border": "#E8DEFF",
    "input.placeholderForeground": "#C9BEE8",
    "dropdown.background": "#FFFFFF",
    "dropdown.foreground": "#2D2A3E",
    "dropdown.border": "#E8DEFF",
    "button.background": "#C792EA",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#D8B4FE",
    "badge.background": "#C792EA",
    "badge.foreground": "#FFFFFF",
    "list.activeSelectionBackground": "#E8DEFF",
    "list.activeSelectionForeground": "#2D2A3E",
    "list.inactiveSelectionBackground": "#E8DEFF66",
    "list.inactiveSelectionForeground": "#2D2A3E",
    "list.hoverBackground": "#F0EBFF",
    "list.hoverForeground": "#2D2A3E",
    "list.focusBackground": "#E8DEFF88",
    "list.focusForeground": "#2D2A3E",
    "list.highlightForeground": "#C792EA",
    "gitDecoration.addedResourceForeground": "#7C6CF5",
    "gitDecoration.modifiedResourceForeground": "#C792EA",
    "gitDecoration.deletedResourceForeground": "#EF4444",
    "gitDecoration.renamedResourceForeground": "#C084FC",
    "gitDecoration.conflictingResourceForeground": "#F59EAE",
    "terminal.background": "#F8F5FF",
    "terminal.foreground": "#2D2A3E",
    "terminal.ansiBlack": "#EDE6FF",
    "terminal.ansiRed": "#EF4444",
    "terminal.ansiGreen": "#7C6CF5",
    "terminal.ansiYellow": "#C792EA",
    "terminal.ansiBlue": "#8B5CF6",
    "terminal.ansiMagenta": "#C084FC",
    "terminal.ansiCyan": "#7C6CF5",
    "terminal.ansiWhite": "#2D2A3E",
    "terminal.ansiBrightBlack": "#C9BEE8",
    "terminal.ansiBrightRed": "#EF4444",
    "terminal.ansiBrightGreen": "#7C6CF5",
    "terminal.ansiBrightYellow": "#C792EA",
    "terminal.ansiBrightBlue": "#8B5CF6",
    "terminal.ansiBrightMagenta": "#C084FC",
    "terminal.ansiBrightCyan": "#7C6CF5",
    "terminal.ansiBrightWhite": "#2D2A3E",
    "minimap.selectionHighlight": "#C792EA33",
    "minimap.findMatchHighlight": "#C792EA22",
    "editorError.foreground": "#EF4444",
    "editorWarning.foreground": "#F59EAE",
    "editorInfo.foreground": "#7C6CF5",
    "editorGutter.modifiedBackground": "#C792EA",
    "editorGutter.addedBackground": "#7C6CF5",
    "editorGutter.deletedBackground": "#EF4444"
  },
  "semanticTokenColors": {
    "namespace": "#8B5CF6",
    "type": "#8B5CF6",
    "class": "#8B5CF6",
    "enum": "#C084FC",
    "interface": "#8B5CF6",
    "struct": "#8B5CF6",
    "typeParameter": "#8B5CF6",
    "typeAlias": "#8B5CF6",
    "parameter": "#4A3F6B",
    "variable": "#2D2A3E",
    "property": "#2D2A3E",
    "enumMember": "#4A3F6B",
    "function": "#7C6CF5",
    "method": "#7C6CF5",
    "macro": "#7C6CF5",
    "keyword": "#8B5CF6",
    "modifier": "#8B5CF6",
    "comment": "#C9BEE8",
    "string": "#C084FC",
    "number": "#F59EAE",
    "regexp": "#7C6CF5",
    "operator": "#7C6CF5"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#C9BEE8"
      }
    },
    {
      "name": "Variables & General Identifiers",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.property",
        "variable.other.object.property",
        "string constant.other.placeholder",
        "meta.block variable.other",
        "support.other.variable",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#2D2A3E"
      }
    },
    {
      "name": "Language Methods & Special Variables",
      "scope": [
        "variable.language",
        "variable.other.self",
        "variable.other.this"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#8B5CF6"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#4A3F6B"
      }
    },
    {
      "name": "Keywords & Storage",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "storage.type.class",
        "storage.type.function",
        "storage.type.interface",
        "storage.type.type",
        "storage.type.namespace",
        "storage.type.enum",
        "storage.type.struct"
      ],
      "settings": {
        "foreground": "#8B5CF6"
      }
    },
    {
      "name": "Operators, Control & Punctuation",
      "scope": [
        "keyword.control",
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.section",
        "punctuation.definition.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.inheritance.php",
        "punctuation.section.embedded",
        "keyword.other.template",
        "keyword.other.substitution",
        "meta.tag"
      ],
      "settings": {
        "foreground": "#7C6CF5"
      }
    },
    {
      "name": "Tags & Deleted Items",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "markup.deleted.git_gutter"
      ],
      "settings": {
        "foreground": "#C084FC"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "variable.function",
        "support.function",
        "keyword.other.special-method",
        "entity.name.method",
        "meta.method",
        "entity.name.method.js",
        "meta.class-method.js entity.name.function.js",
        "variable.function.constructor"
      ],
      "settings": {
        "foreground": "#7C6CF5"
      }
    },
    {
      "name": "Numbers, Constants, Units & Escapes",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.escape",
        "keyword.other.unit",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#F59EAE"
      }
    },
    {
      "name": "General Constants",
      "scope": [
        "constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#4A3F6B"
      }
    },
    {
      "name": "Strings, Keys & Symbols",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "constant.other.symbol",
        "constant.other.key",
        "entity.other.inherited-class",
        "markup.heading",
        "markup.inserted.git_gutter",
        "meta.group.braces.curly constant.other.object.key.js string.unquoted.label.js"
      ],
      "settings": {
        "foreground": "#C084FC"
      }
    },
    {
      "name": "Classes, Namespaces & Support Types",
      "scope": [
        "entity.name",
        "entity.name.class",
        "entity.name.type.class",
        "support.class",
        "support.other.namespace.use.php",
        "meta.use.php",
        "support.other.namespace.php",
        "markup.changed.git_gutter",
        "support.type.sys-types",
        "entity.name.module.js",
        "variable.import.parameter.js",
        "variable.other.class.js"
      ],
      "settings": {
        "foreground": "#8B5CF6"
      }
    },
    {
      "name": "Types & Data Models",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.type.primitive",
        "support.type.builtin"
      ],
      "settings": {
        "foreground": "#7C6CF5"
      }
    },
    {
      "name": "Interfaces",
      "scope": [
        "entity.name.type.interface",
        "support.interface"
      ],
      "settings": {
        "foreground": "#8B5CF6"
      }
    },
    {
      "name": "Enums",
      "scope": [
        "entity.name.type.enum",
        "entity.name.variable.enum-member",
        "support.enum"
      ],
      "settings": {
        "foreground": "#C084FC"
      }
    },
    {
      "name": "CSS / SCSS / LESS Properties",
      "scope": [
        "source.css support.type.property-name",
        "source.sass support.type.property-name",
        "source.scss support.type.property-name",
        "source.less support.type.property-name",
        "source.stylus support.type.property-name",
        "source.postcss support.type.property-name",
        "support.type.property-name.css",
        "constant.other.color",
        "source.sass keyword.control"
      ],
      "settings": {
        "foreground": "#7C6CF5"
      }
    },
    {
      "name": "Attributes & HTML Properties",
      "scope": [
        "entity.other.attribute-name",
        "text.html.basic entity.other.attribute-name.html",
        "text.html.basic entity.other.attribute-name",
        "entity.other.attribute-name.class"
      ],
      "settings": {
        "foreground": "#C084FC"
      }
    },
    {
      "name": "Decorators & Annotations",
      "scope": [
        "meta.annotation",
        "meta.decorator",
        "entity.name.type.annotation",
        "punctuation.decorator",
        "entity.name.function.decorator",
        "tag.decorator.js entity.name.tag.js",
        "tag.decorator.js punctuation.definition.tag.js",
        "meta.attribute.rust"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#7C6CF5"
      }
    },
    {
      "name": "Regex & Escape Characters",
      "scope": [
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#7C6CF5"
      }
    },
    {
      "name": "JSON & YAML Key Level Styling",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml",
        "source.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#8B5CF6"
      }
    },
    {
      "name": "Markdown - Text, Headings & Code",
      "scope": [
        "text.html.markdown",
        "punctuation.definition.list_item.markdown",
        "markup.raw.block.fenced.markdown",
        "punctuation.definition.fenced.markdown",
        "markup.table"
      ],
      "settings": {
        "foreground": "#2D2A3E"
      }
    },
    {
      "name": "Markdown - Inline Code & Headings",
      "scope": [
        "text.html.markdown markup.inline.raw.markdown",
        "markdown.heading",
        "markup.heading",
        "markup.heading entity.name",
        "markup.raw.block"
      ],
      "settings": {
        "foreground": "#C084FC"
      }
    },
    {
      "name": "Markup - Bold & Italic",
      "scope": [
        "markup.italic",
        "markup.bold",
        "markup.bold markup.italic"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#C084FC"
      }
    },
    {
      "name": "Markup - Git Actions",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#7C6CF5"
      }
    },
    {
      "name": "Markup - Git Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#EF4444"
      }
    },
    {
      "name": "Markup - Git Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#8B5CF6"
      }
    },
    {
      "name": "Invalid & Illegal Syntax",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#EF4444"
      }
    }
  ]
}
